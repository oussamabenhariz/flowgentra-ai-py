class MockLLM:
    """Scripted, offline LLM for tests — no network, no credentials, deterministic.

    Example::

        mock = MockLLM()
        mock.when_contains("weather", "It is sunny")
        mock.otherwise("I don't know")
        llm = mock.as_llm()  # -> LLM, drop-in anywhere a real LLM is expected
    """

    def __init__(self) -> None: ...
    @staticmethod
    def always(reply: str) -> "MockLLM":
        """Always return the same reply, regardless of input."""
        ...
    @staticmethod
    def sequence(replies: List[str]) -> "MockLLM":
        """Return `replies` in order, one per call (repeats the last once exhausted)."""
        ...
    def when_contains(self, needle: str, reply: str) -> None:
        """Reply with `reply` when the latest user message contains `needle`."""
        ...
    def when(self, predicate: Callable[[List[Dict[str, Any]]], Optional[str]]) -> None:
        """Reply based on a predicate over the message history. `predicate`
        receives a list of `{"role", "content"}` dicts and returns the reply, or
        None to fall through to the next matcher."""
        ...
    def otherwise(self, reply: str) -> None:
        """Fallback reply when no matcher fires."""
        ...
    def with_usage(self) -> None:
        """Report token usage from `chat_with_usage` (rough word-count estimate)."""
        ...
    def call_count(self) -> int:
        """Number of times `chat*` has been invoked."""
        ...
    def as_llm(self) -> "LLM":
        """Wrap as an `LLM` — usable anywhere a real LLM is expected."""
        ...
    def __repr__(self) -> str: ...

