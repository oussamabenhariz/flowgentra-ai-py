class Command:
    """Resume instructions for `StateGraph.resume_command()`.

    Mirrors LangGraph's ``Command(resume=, update=, goto=)``:

    - ``update={...}`` — merge a partial state update before resuming, validated
      against the state schema. This is how a Python node function receives a
      human's answer (it reads it back from ``state``, not from ``resume``).
    - ``goto="node_name"`` — resume at an arbitrary node instead of the
      checkpoint's natural successor.
    - ``resume=value`` — hand a value to the paused node's context. Only
      reachable from Rust-authored nodes; Python node functions receive only
      ``state: dict`` and cannot see it.

    Example:
        result = graph.resume_command("t1", Command(update={"answer": "yes"}))
        result = graph.resume_command("t1", Command(goto="cleanup"))
    """

    def __init__(
        self,
        resume: Optional[Any] = None,
        update: Optional[Dict[str, Any]] = None,
        goto: Optional[str] = None,
    ) -> None: ...
    def __repr__(self) -> str: ...

class AsyncGraphStream:
    """Async iterator over live execution events (CompiledGraph.astream()).

    Each __anext__ is a native awaitable driven by the tokio runtime — no
    per-event thread bounce. Yields event dicts, ending with a `values` event
    carrying the final state; raises the graph's typed error on failure.
    """

    def __aiter__(self) -> "AsyncGraphStream": ...
    def __anext__(self) -> Awaitable[Dict[str, Any]]: ...

