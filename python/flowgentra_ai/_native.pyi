END: str
"""The END sentinel constant ("__end__"). Use as edge target to terminate the graph."""

class StateGraphBuilder:
    """Build a state graph with Python callables as nodes.

    Example::

        from flowgentra_ai import StateGraphBuilder, State, END

        def process(state):
            state["output"] = state["input"].upper()
            return state

        builder = StateGraphBuilder()
        builder.add_node("process", process)
        builder.set_entry_point("process")
        builder.add_edge("process", END)
        graph = builder.compile()

        result = graph.invoke(State({"input": "hello"}))
        print(result.to_dict())  # {"input": "hello", "output": "HELLO"}
    """

    def __init__(self) -> None: ...
    def add_node(self, name: str, func: Callable[[State], State]) -> None: ...
    def add_edge(self, from_node: str, to_node: str) -> None: ...
    def add_conditional_edge(
        self, from_node: str, router: Callable[[State], str]
    ) -> None: ...
    def add_conditional_edges(
        self, from_node: str, router: Callable[[State], str]
    ) -> None:
        """Alias for add_conditional_edge (LangGraph-compatible plural spelling)."""
        ...
    def set_max_duration(self, seconds: float) -> None:
        """Wall-clock budget for a single invocation; breach raises WorkflowTimeoutError."""
        ...
    def set_max_tokens(self, max_tokens: int) -> None:
        """Total-token budget for a single invocation, checked against the
        cumulative ``_token_usage.total_tokens`` state field; breach raises
        WorkflowTimeoutError."""
        ...
    def set_max_cost(self, max_cost_usd: float) -> None:
        """Estimated-cost budget in USD for a single invocation, checked against
        the cumulative ``_cost_usd`` state field that nodes populate via
        ``record_usage_with_cost``; breach raises WorkflowTimeoutError. Cost sums
        per LLM call at that model's price (see ``llm.set_model_price``)."""
        ...
    def set_entry_point(self, name: str) -> None: ...
    def set_max_steps(self, max_steps: int) -> None:
        """Set the maximum number of execution iterations before the graph aborts.

        This maps directly to the Rust runtime's ``graph.recursion_limit`` config
        field.  The default is **25** (same as the Rust default).  Accepted range:
        1–10 000; values outside this range raise ``ValueError`` at runtime.

        Args:
            max_steps: Maximum loop iterations.  Raise for long pipelines;
                lower for tighter safety in production.
        """
        ...
    def interrupt_before(self, name: str) -> None: ...
    def interrupt_after(self, name: str) -> None: ...
    def add_subgraph(self, name: str, subgraph: "StateGraph") -> None: ...
    def add_retry_node(
        self,
        name: str,
        func: Callable[[State], State],
        max_retries: int = 3,
        backoff_ms: int = 1000,
        backoff_multiplier: float = 2.0,
        max_backoff_ms: int = 30000,
    ) -> None: ...
    def add_timeout_node(
        self,
        name: str,
        func: Callable[[State], State],
        timeout_ms: int,
        on_timeout: str = "error",
    ) -> None: ...
    def add_llm_node(
        self,
        name: str,
        llm: "LLM",
        prompt_key: str = "prompt",
        output_key: str = "llm_response",
        system_prompt: Optional[str] = None,
    ) -> None: ...
    def add_planner_node(
        self,
        name: str,
        llm: "LLM",
        prompt: Optional[str] = None,
    ) -> None: ...
    def add_evaluation_node(
        self,
        handler: Callable[[State], State],
        config: "EvaluationNodeConfig",
        scorer: Optional[Callable[[Any, int], Tuple[float, str]]] = None,
    ) -> None: ...
    def add_loop_node(
        self,
        name: str,
        func: Callable[[dict], dict],
        max_iterations: int = 10,
        break_condition: Optional[Callable[[dict], bool]] = None,
    ) -> None: ...
    def add_parallel_node(
        self,
        name: str,
        branches: Union[List[Callable[[dict], dict]], Dict[str, Callable[[dict], dict]]],
    ) -> None: ...
    def set_checkpointer(self, base_dir: str) -> None: ...
    def set_sqlite_checkpointer(self, url: str) -> None:
        """Persist checkpoints in SQLite (e.g. \"sqlite://checkpoints.db\")."""
        ...
    def set_postgres_checkpointer(self, url: str) -> None:
        """Persist checkpoints in Postgres (e.g. "postgres://user:pass@host/db").

        The pick for a horizontally-scaled service where multiple
        processes/replicas may resume the same thread — SQLite and the
        in-memory default are both single-process. The checkpoint table is
        created if missing.
        """
        ...
    def set_mysql_checkpointer(self, url: str) -> None:
        """Persist checkpoints in MySQL (e.g. "mysql://user:pass@host/db")."""
        ...
    def set_redis_checkpointer(self, url: str, ttl_secs: Optional[int] = None) -> None:
        """Persist checkpoints in Redis (e.g. "redis://localhost:6379"). `ttl_secs`
        expires each checkpoint after that many seconds."""
        ...
    def set_mongo_checkpointer(
        self, url: str, db: str = "flowgentra", collection: str = "checkpoints"
    ) -> None:
        """Persist checkpoints in MongoDB."""
        ...
    def add_cached_node(
        self,
        name: str,
        func: Callable[[State], State],
        max_entries: int = 128,
        ttl_secs: Optional[float] = None,
    ) -> None:
        """Add a node memoized by input-state hash (for expensive deterministic nodes)."""
        ...
    def compile(self, tracer: Optional["ExecutionTracer"] = None) -> "StateGraph": ...
    def __repr__(self) -> str: ...

